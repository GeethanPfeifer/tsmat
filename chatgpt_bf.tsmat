;;; https://chatgpt.com/share/6a86daf9-83d4-83ec-acaf-1aadba19ccfe
;;; Note: I decided to make the controller halt after a single signal, as opposed to multiple, so the last message in that chat is not relevant.
(
  ;; ============================================================
  ;; MACHINE 0 — Brainfuck interpreter
  ;;
  ;; External input format:
  ;;
  ;;     <brainfuck program> NUL <brainfuck input>
  ;;
  ;; Non-BF characters in the program portion are ignored.
  ;; ============================================================
  (0
    ;; Stack-server commands.
    (ADD 240 1)   ; PUSH / constant true
    (ADD 241 2)   ; POP
    (ADD 242 3)   ; EMPTY

    ;; ==========================================================
    ;; Load Brainfuck program
    ;; ==========================================================

    (LABEL source_read)
    (READIN 0)

    ;; NUL ends the source program.
    (IF 0 source_nonzero)
    (IF 240 source_done)

    (LABEL source_nonzero)

    ;; '+': 43
    (PUSH 0)
    (POP 1)
    (ADD 1 213)
    (IF 1 source_test_comma)
    (IF 240 source_keep)

    ;; ',': 44
    (LABEL source_test_comma)
    (PUSH 0)
    (POP 1)
    (ADD 1 212)
    (IF 1 source_test_minus)
    (IF 240 source_keep)

    ;; '-': 45
    (LABEL source_test_minus)
    (PUSH 0)
    (POP 1)
    (ADD 1 211)
    (IF 1 source_test_dot)
    (IF 240 source_keep)

    ;; '.': 46
    (LABEL source_test_dot)
    (PUSH 0)
    (POP 1)
    (ADD 1 210)
    (IF 1 source_test_left)
    (IF 240 source_keep)

    ;; '<': 60
    (LABEL source_test_left)
    (PUSH 0)
    (POP 1)
    (ADD 1 196)
    (IF 1 source_test_right)
    (IF 240 source_keep)

    ;; '>': 62
    (LABEL source_test_right)
    (PUSH 0)
    (POP 1)
    (ADD 1 194)
    (IF 1 source_test_open)
    (IF 240 source_keep)

    ;; '[': 91
    (LABEL source_test_open)
    (PUSH 0)
    (POP 1)
    (ADD 1 165)
    (IF 1 source_test_close)
    (IF 240 source_keep)

    ;; ']': 93
    (LABEL source_test_close)
    (PUSH 0)
    (POP 1)
    (ADD 1 163)
    (IF 1 source_invalid)
    (IF 240 source_keep)

    ;; Everything other than the eight BF instructions is a comment.
    (LABEL source_invalid)
    (IF 240 source_read)

    ;; Initially put the program onto stack machine 2.
    (LABEL source_keep)
    (SEND 240 2)
    (SEND 0 2)
    (IF 240 source_read)


    ;; ==========================================================
    ;; Reverse source into machine 1.
    ;;
    ;; machine 1 becomes the "future" side of the program zipper,
    ;; with the first instruction on top.
    ;; ==========================================================

    (LABEL source_done)

    (LABEL reverse_loop)

    (SEND 242 2)
    (READ 2)
    (IF 2 reverse_done)

    (SEND 241 2)
    (READ 3)

    (SEND 240 1)
    (SEND 3 1)

    (IF 240 reverse_loop)


    ;; ==========================================================
    ;; Execution
    ;;
    ;; Program:
    ;;
    ;;   machine 2       machine 1
    ;;     past      IP     future
    ;;
    ;; Tape:
    ;;
    ;;   machine 3       a[20]       machine 4
    ;;     left         current        right
    ;; ==========================================================

    (LABEL reverse_done)

    (LABEL exec_loop)

    ;; Program future empty => finished.
    (SEND 242 1)
    (READ 2)
    (IF 2 program_done)

    ;; Fetch current opcode.
    (SEND 241 1)
    (READ 10)


    ;; ==========================================================
    ;; Decode
    ;; ==========================================================

    ;; +
    (PUSH 10)
    (POP 11)
    (ADD 11 213)
    (IF 11 test_comma)
    (IF 240 op_plus)

    ;; ,
    (LABEL test_comma)
    (PUSH 10)
    (POP 11)
    (ADD 11 212)
    (IF 11 test_minus)
    (IF 240 op_comma)

    ;; -
    (LABEL test_minus)
    (PUSH 10)
    (POP 11)
    (ADD 11 211)
    (IF 11 test_dot)
    (IF 240 op_minus)

    ;; .
    (LABEL test_dot)
    (PUSH 10)
    (POP 11)
    (ADD 11 210)
    (IF 11 test_left)
    (IF 240 op_dot)

    ;; <
    (LABEL test_left)
    (PUSH 10)
    (POP 11)
    (ADD 11 196)
    (IF 11 test_right)
    (IF 240 op_left)

    ;; >
    (LABEL test_right)
    (PUSH 10)
    (POP 11)
    (ADD 11 194)
    (IF 11 test_open)
    (IF 240 op_right)

    ;; [
    (LABEL test_open)
    (PUSH 10)
    (POP 11)
    (ADD 11 165)
    (IF 11 test_close)
    (IF 240 op_open)

    ;; ]
    (LABEL test_close)
    (PUSH 10)
    (POP 11)
    (ADD 11 163)
    (IF 11 malformed)
    (IF 240 op_close)


    ;; ==========================================================
    ;; +
    ;; ==========================================================

    (LABEL op_plus)
    (ADD 20 1)
    (IF 240 advance)


    ;; ==========================================================
    ;; -
    ;; ==========================================================

    (LABEL op_minus)
    (ADD 20 255)
    (IF 240 advance)


    ;; ==========================================================
    ;; ,
    ;;
    ;; Unlike inter-machine READ, this explicitly requests a byte
    ;; from external stdin.
    ;; ==========================================================

    (LABEL op_comma)
    (READIN 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; .
    ;; ==========================================================

    (LABEL op_dot)
    (SENDOUT 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; <
    ;; ==========================================================

    (LABEL op_left)

    ;; Current cell moves onto right-hand stack.
    (SEND 240 4)
    (SEND 20 4)

    ;; Is there a known cell to our left?
    (SEND 242 3)
    (READ 2)
    (IF 2 left_new_cell)

    ;; Yes: pop it and make it current.
    (SEND 241 3)
    (READ 20)
    (IF 240 advance)

    ;; No: Brainfuck tape cells start at zero.
    (LABEL left_new_cell)
    (PUSH 250)
    (POP 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; >
    ;; ==========================================================

    (LABEL op_right)

    ;; Current cell moves onto left-hand stack.
    (SEND 240 3)
    (SEND 20 3)

    ;; Is there a known cell to our right?
    (SEND 242 4)
    (READ 2)
    (IF 2 right_new_cell)

    (SEND 241 4)
    (READ 20)
    (IF 240 advance)

    (LABEL right_new_cell)
    (PUSH 250)
    (POP 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; [
    ;;
    ;; If the cell is nonzero, execute the body.
    ;; Otherwise scan forward to its corresponding ].
    ;; ==========================================================

    (LABEL op_open)

    (IF 20 advance)

    ;; The '[' itself is now behind the IP.
    (SEND 240 2)
    (SEND 10 2)

    (IF 240 forward_scan)


    ;; ==========================================================
    ;; ]
    ;;
    ;; If zero, leave the loop.
    ;; If nonzero, scan backward to the corresponding '['.
    ;; ==========================================================

    (LABEL op_close)

    (IF 20 close_nonzero)
    (IF 240 advance)

    (LABEL close_nonzero)

    ;; Put the current ] back onto future while rewinding.
    (SEND 240 1)
    (SEND 10 1)

    (IF 240 backward_scan)


    ;; ==========================================================
    ;; Normal IP advancement
    ;; ==========================================================

    (LABEL advance)

    ;; Current opcode moves from future to past.
    (SEND 240 2)
    (SEND 10 2)

    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Forward bracket scan
    ;;
    ;; Machine 0's local stack is used as an unbounded nesting
    ;; counter.
    ;; ==========================================================

    (LABEL forward_scan)

    ;; Future empty before finding ] => malformed program.
    (SEND 242 1)
    (READ 2)
    (IF 2 malformed)

    ;; future -> past
    (SEND 241 1)
    (READ 12)

    (SEND 240 2)
    (SEND 12 2)

    ;; Is instruction '['?
    (PUSH 12)
    (POP 13)
    (ADD 13 165)
    (IF 13 forward_test_close)

    ;; Nested opening bracket.
    (PUSH 240)
    (IF 240 forward_scan)

    ;; Is instruction ']'?
    (LABEL forward_test_close)
    (PUSH 12)
    (POP 13)
    (ADD 13 163)
    (IF 13 forward_scan)

    ;; If nesting counter is empty, this ] matches the original [.
    (EMPTY forward_match)

    ;; Otherwise close one nested level.
    (POP 14)
    (IF 240 forward_scan)

    (LABEL forward_match)
    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Backward bracket scan
    ;; ==========================================================

    (LABEL backward_scan)

    ;; Past empty before finding [ => malformed.
    (SEND 242 2)
    (READ 2)
    (IF 2 malformed)

    ;; past -> future
    (SEND 241 2)
    (READ 12)

    (SEND 240 1)
    (SEND 12 1)

    ;; Is instruction ']'?
    (PUSH 12)
    (POP 13)
    (ADD 13 163)
    (IF 13 backward_test_open)

    ;; Nested closing bracket.
    (PUSH 240)
    (IF 240 backward_scan)

    ;; Is instruction '['?
    (LABEL backward_test_open)
    (PUSH 12)
    (POP 13)
    (ADD 13 165)
    (IF 13 backward_scan)

    ;; At depth zero this is the matching '['.
    (EMPTY backward_match)

    ;; Otherwise close one nested level.
    (POP 14)
    (IF 240 backward_scan)

    (LABEL backward_match)

    ;; Matching '[' is now the top of machine 1.
    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Termination
    ;;
    ;; Since one HALT terminates the whole computation, no shutdown
    ;; protocol for machines 1–4 is required.
    ;; ==========================================================

    (LABEL malformed)
    (HALT)

    (LABEL program_done)
    (HALT)
  )


  ;; ============================================================
  ;; MACHINE 1 — program future
  ;;
  ;; Generic stack-server protocol:
  ;;
  ;;   1 VALUE    push VALUE
  ;;   2          pop; reply to machine 0
  ;;   3          empty?; reply 0 or 1 to machine 0
  ;; ============================================================

  (1
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    ;; PUSH?
    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    ;; POP?
    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    ;; EMPTY
    (LABEL not_pop)
    (EMPTY is_empty)

    ;; false
    (SEND 254 0)
    (IF 255 loop)

    ;; true
    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 2 — program past
  ;; ============================================================

  (2
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 3 — tape left
  ;; ============================================================

  (3
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 4 — tape right
  ;; ============================================================

  (4
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )
)
