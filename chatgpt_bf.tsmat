;;; https://chatgpt.com/share/6a86daf9-83d4-83ec-acaf-1aadba19ccfe

(
  ;; ============================================================
  ;; MACHINE 0 — Brainfuck interpreter
  ;; ============================================================
  (0
    ;; Constants
    ;;
    ;; 240 = 1 = PUSH command / unconditional-branch true
    ;; 241 = 2 = POP command
    ;; 242 = 3 = EMPTY command
    ;; 250 = permanently zero
    (ADD 240 1)
    (ADD 241 2)
    (ADD 242 3)

    ;; ----------------------------------------------------------
    ;; Read Brainfuck source.
    ;;
    ;; Convention retained from before:
    ;;
    ;;     <brainfuck source> NUL <brainfuck input>
    ;;
    ;; Non-BF source characters are ignored.
    ;;
    ;; Source is initially pushed onto machine 2.
    ;; ----------------------------------------------------------

    (LABEL source_read)
    (READ 0)

    ;; NUL terminates the source.
    (IF 0 source_nonzero)
    (IF 240 source_done)

    (LABEL source_nonzero)

    ;; '+': 43
    (PUSH 0)
    (POP 1)
    (ADD 1 213)
    (IF 1 source_test_1)
    (IF 240 source_keep)

    ;; ',': 44
    (LABEL source_test_1)
    (PUSH 0)
    (POP 1)
    (ADD 1 212)
    (IF 1 source_test_2)
    (IF 240 source_keep)

    ;; '-': 45
    (LABEL source_test_2)
    (PUSH 0)
    (POP 1)
    (ADD 1 211)
    (IF 1 source_test_3)
    (IF 240 source_keep)

    ;; '.': 46
    (LABEL source_test_3)
    (PUSH 0)
    (POP 1)
    (ADD 1 210)
    (IF 1 source_test_4)
    (IF 240 source_keep)

    ;; '<': 60
    (LABEL source_test_4)
    (PUSH 0)
    (POP 1)
    (ADD 1 196)
    (IF 1 source_test_5)
    (IF 240 source_keep)

    ;; '>': 62
    (LABEL source_test_5)
    (PUSH 0)
    (POP 1)
    (ADD 1 194)
    (IF 1 source_test_6)
    (IF 240 source_keep)

    ;; '[': 91
    (LABEL source_test_6)
    (PUSH 0)
    (POP 1)
    (ADD 1 165)
    (IF 1 source_test_7)
    (IF 240 source_keep)

    ;; ']': 93
    (LABEL source_test_7)
    (PUSH 0)
    (POP 1)
    (ADD 1 163)
    (IF 1 source_invalid)
    (IF 240 source_keep)

    ;; Ignore anything else.
    (LABEL source_invalid)
    (IF 240 source_read)

    ;; Push BF instruction onto machine 2.
    (LABEL source_keep)
    (SEND 240 2)
    (SEND 0 2)
    (IF 240 source_read)


    ;; ----------------------------------------------------------
    ;; Reverse program.
    ;;
    ;; During loading:
    ;;
    ;; machine 2:
    ;;     bottom [ first ... last ] top
    ;;
    ;; We want machine 1:
    ;;
    ;;     bottom [ last ... first ] top
    ;;
    ;; so its top is the current instruction.
    ;; ----------------------------------------------------------

    (LABEL source_done)

    (LABEL reverse_loop)

    ;; Is machine 2 empty?
    (SEND 242 2)
    (READ 2)
    (IF 2 reverse_done)

    ;; Pop from machine 2.
    (SEND 241 2)
    (READ 3)

    ;; Push onto machine 1.
    (SEND 240 1)
    (SEND 3 1)

    (IF 240 reverse_loop)


    ;; ==========================================================
    ;; Main interpreter
    ;;
    ;; Program zipper:
    ;;
    ;; machine 2 = instructions before IP
    ;; machine 1 = instruction at/after IP
    ;;
    ;; Tape zipper:
    ;;
    ;; machine 3 = cells left of DP
    ;; a[20]     = current cell
    ;; machine 4 = cells right of DP
    ;; ==========================================================

    (LABEL reverse_done)

    (LABEL exec_loop)

    ;; End of program?
    (SEND 242 1)
    (READ 2)
    (IF 2 program_done)

    ;; Fetch current opcode.
    (SEND 241 1)
    (READ 10)


    ;; ----------------------------------------------------------
    ;; Decode opcode
    ;; ----------------------------------------------------------

    ;; '+'
    (PUSH 10)
    (POP 11)
    (ADD 11 213)
    (IF 11 op_test_1)
    (IF 240 op_plus)

    ;; ','
    (LABEL op_test_1)
    (PUSH 10)
    (POP 11)
    (ADD 11 212)
    (IF 11 op_test_2)
    (IF 240 op_comma)

    ;; '-'
    (LABEL op_test_2)
    (PUSH 10)
    (POP 11)
    (ADD 11 211)
    (IF 11 op_test_3)
    (IF 240 op_minus)

    ;; '.'
    (LABEL op_test_3)
    (PUSH 10)
    (POP 11)
    (ADD 11 210)
    (IF 11 op_test_4)
    (IF 240 op_dot)

    ;; '<'
    (LABEL op_test_4)
    (PUSH 10)
    (POP 11)
    (ADD 11 196)
    (IF 11 op_test_5)
    (IF 240 op_left)

    ;; '>'
    (LABEL op_test_5)
    (PUSH 10)
    (POP 11)
    (ADD 11 194)
    (IF 11 op_test_6)
    (IF 240 op_right)

    ;; '['
    (LABEL op_test_6)
    (PUSH 10)
    (POP 11)
    (ADD 11 165)
    (IF 11 op_test_7)
    (IF 240 op_open)

    ;; ']'
    (LABEL op_test_7)
    (PUSH 10)
    (POP 11)
    (ADD 11 163)
    (IF 11 malformed)
    (IF 240 op_close)


    ;; ==========================================================
    ;; +
    ;; ==========================================================

    (LABEL op_plus)
    (ADD 20 1)
    (IF 240 advance)


    ;; ==========================================================
    ;; -
    ;; ==========================================================

    (LABEL op_minus)

    ;; Byte arithmetic means +255 == -1 mod 256.
    (ADD 20 255)
    (IF 240 advance)


    ;; ==========================================================
    ;; ,
    ;; ==========================================================

    (LABEL op_comma)

    ;; Controller supplies the next external byte as an integer.
    (READ 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; .
    ;; ==========================================================

    (LABEL op_dot)

    ;; -1 denotes external output under the same convention as
    ;; the earlier version.
    (SEND 20 -1)
    (IF 240 advance)


    ;; ==========================================================
    ;; <
    ;; ==========================================================

    (LABEL op_left)

    ;; Current cell moves onto right stack.
    (SEND 240 4)
    (SEND 20 4)

    ;; Anything to the left?
    (SEND 242 3)
    (READ 2)
    (IF 2 left_zero)

    ;; Pop previous left cell.
    (SEND 241 3)
    (READ 20)
    (IF 240 advance)

    ;; Unvisited cells contain zero.
    (LABEL left_zero)
    (PUSH 250)
    (POP 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; >
    ;; ==========================================================

    (LABEL op_right)

    ;; Current cell moves onto left stack.
    (SEND 240 3)
    (SEND 20 3)

    ;; Anything to the right?
    (SEND 242 4)
    (READ 2)
    (IF 2 right_zero)

    ;; Pop previous right cell.
    (SEND 241 4)
    (READ 20)
    (IF 240 advance)

    (LABEL right_zero)
    (PUSH 250)
    (POP 20)
    (IF 240 advance)


    ;; ==========================================================
    ;; [
    ;; ==========================================================

    (LABEL op_open)

    ;; Nonzero: execute loop body normally.
    (IF 20 advance)

    ;; Zero: skip to corresponding ']'.
    ;;
    ;; Current '[' belongs to program-past.
    (SEND 240 2)
    (SEND 10 2)

    (IF 240 forward_scan)


    ;; ==========================================================
    ;; ]
    ;; ==========================================================

    (LABEL op_close)

    ;; Zero: loop has finished.
    (IF 20 close_nonzero)
    (IF 240 advance)

    ;; Nonzero: rewind to matching '['.
    (LABEL close_nonzero)

    ;; Current ']' must remain in program-future while rewinding.
    (SEND 240 1)
    (SEND 10 1)

    (IF 240 backward_scan)


    ;; ==========================================================
    ;; Normal IP advance
    ;; ==========================================================

    (LABEL advance)

    ;; Current opcode becomes part of program-past.
    (SEND 240 2)
    (SEND 10 2)

    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Scan forward to matching ']'
    ;;
    ;; Machine 0's own stack is an unbounded nesting counter.
    ;; One stack item represents one nested '['.
    ;; ==========================================================

    (LABEL forward_scan)

    ;; No matching ].
    (SEND 242 1)
    (READ 2)
    (IF 2 malformed)

    ;; Move one instruction future -> past.
    (SEND 241 1)
    (READ 12)

    (SEND 240 2)
    (SEND 12 2)

    ;; '[' ?
    (PUSH 12)
    (POP 13)
    (ADD 13 165)
    (IF 13 forward_test_close)

    ;; Nested '['.
    (PUSH 240)
    (IF 240 forward_scan)

    ;; ']' ?
    (LABEL forward_test_close)
    (PUSH 12)
    (POP 13)
    (ADD 13 163)
    (IF 13 forward_scan)

    ;; A ']' at nesting depth zero is the one we want.
    (EMPTY forward_match)

    ;; Otherwise close one nested pair.
    (POP 14)
    (IF 240 forward_scan)

    (LABEL forward_match)
    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Scan backward to matching '['
    ;;
    ;; A nested ']' pushes a nesting marker.
    ;; A nested '[' removes one.
    ;; ==========================================================

    (LABEL backward_scan)

    ;; No matching '['.
    (SEND 242 2)
    (READ 2)
    (IF 2 malformed)

    ;; Move one instruction past -> future.
    (SEND 241 2)
    (READ 12)

    (SEND 240 1)
    (SEND 12 1)

    ;; ']' ?
    (PUSH 12)
    (POP 13)
    (ADD 13 163)
    (IF 13 backward_test_open)

    ;; Nested ']'.
    (PUSH 240)
    (IF 240 backward_scan)

    ;; '[' ?
    (LABEL backward_test_open)
    (PUSH 12)
    (POP 13)
    (ADD 13 165)
    (IF 13 backward_scan)

    ;; '[' at nesting depth zero is the target.
    (EMPTY backward_match)

    ;; Otherwise it matches one nested ']'.
    (POP 14)
    (IF 240 backward_scan)

    (LABEL backward_match)

    ;; Matching '[' is now on top of program-future.
    ;; exec_loop will fetch and execute it.
    (IF 240 exec_loop)


    ;; ==========================================================
    ;; Termination
    ;; ==========================================================

    (LABEL malformed)
    (HALT)

    (LABEL program_done)
    (HALT)
  )


  ;; ============================================================
  ;; MACHINE 1 — generic stack server
  ;;
  ;; Protocol:
  ;;
  ;;   SEND 1        => PUSH; next received integer is the value
  ;;   SEND 2        => POP; reply to machine 0 with value
  ;;   SEND 3        => EMPTY; reply 0/1 to machine 0
  ;;
  ;; Machine 0 performs operations synchronously, so replies from
  ;; different servers cannot be confused.
  ;; ============================================================

  (1
    ;; a[255] = 1
    ;; a[254] = 0
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    ;; command == 1?
    (ADD 0 255)
    (IF 0 not_push)

    ;; PUSH
    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    ;; command == 2?
    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    ;; POP
    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    ;; Otherwise command == 3: EMPTY.
    (LABEL not_pop)
    (EMPTY is_empty)

    ;; false
    (SEND 254 0)
    (IF 255 loop)

    ;; true
    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 2 — program-past stack
  ;; ============================================================

  (2
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 3 — cells left of data pointer
  ;; ============================================================

  (3
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )


  ;; ============================================================
  ;; MACHINE 4 — cells right of data pointer
  ;; ============================================================

  (4
    (ADD 255 1)

    (LABEL loop)
    (READ 0)

    (ADD 0 255)
    (IF 0 not_push)

    (READ 1)
    (PUSH 1)
    (IF 255 loop)

    (LABEL not_push)
    (ADD 0 255)
    (IF 0 not_pop)

    (POP 1)
    (SEND 1 0)
    (IF 255 loop)

    (LABEL not_pop)
    (EMPTY is_empty)

    (SEND 254 0)
    (IF 255 loop)

    (LABEL is_empty)
    (SEND 255 0)
    (IF 255 loop)
  )
)